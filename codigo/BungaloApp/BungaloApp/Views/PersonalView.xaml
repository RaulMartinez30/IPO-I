<UserControl x:Class="BungaloApp.PersonalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1*" MinWidth="330"/>
        </Grid.ColumnDefinitions>

        <!-- LISTADO -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GESTIÓN DE PERSONAL" Style="{StaticResource H2}"/>
                <Grid DockPanel.Dock="Top" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtBuscar" Height="28" VerticalContentAlignment="Center" ToolTip="Buscar por nombre o especialidad" TextChanged="Filtro_Changed"/>
                    <ComboBox x:Name="cmbFiltroEstado" Grid.Column="1" Width="120" Margin="6,0,0,0" SelectionChanged="Filtro_Changed"/>
                </Grid>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="lblTotal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="Nuevo empleado  ＋" Style="{StaticResource BtnAzul}" HorizontalAlignment="Right" Click="Nuevo_Click"/>
                </DockPanel>
                <DataGrid x:Name="dgPersonal" SelectionChanged="dgPersonal_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                        <DataGridTextColumn Header="EMPLEADO" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="CONTACTO" Binding="{Binding Contacto}" Width="Auto"/>
                        <DataGridTextColumn Header="IDIOMAS" Binding="{Binding Idiomas}" Width="Auto"/>
                        <DataGridTextColumn Header="ESPECIALIDAD" Binding="{Binding Especialidad}" Width="*"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoTxt}" Foreground="{Binding EstadoColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- DETALLES -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DETALLES DE EMPLEADO" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="GUARDAR" Style="{StaticResource BtnAzul}" Click="Guardar_Click"/>
                    <Button x:Name="btnBaja" Content="DAR BAJA" Style="{StaticResource BtnRojo}" Click="Baja_Click"/>
                    <Button Content="CANCELAR" Style="{StaticResource BtnGris}" Click="Cancelar_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <Border Width="90" Height="90" CornerRadius="45" Background="#90A4AE" BorderBrush="Black" BorderThickness="2">
                                    <Grid>
                                        <TextBlock x:Name="lblIniciales" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="imgFoto" Width="86" Height="86" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="43,43" RadiusX="43" RadiusY="43"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>
                                <Button Content="Subir/cambiar foto" Style="{StaticResource BtnGris}" Padding="6,2" FontSize="11" Click="Foto_Click"/>
                            </StackPanel>
                            <StackPanel Margin="14,0,0,0" Width="170">
                                <TextBlock Text="Nombre" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtNombre"/>
                                <TextBlock Text="Apellidos" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtApellidos"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Teléfono" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtTelefono" MaxLength="9"/>
                        <TextBlock Text="E-mail" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtEmail"/>
                        <TextBlock Text="IDIOMAS (ej. ES / EN)" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtIdiomas"/>
                        <TextBlock Text="ESPECIALIDADES" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtEspecialidad"/>
                        <TextBlock Text="FORMACIÓN Y TITULACIÓN" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtFormacion" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

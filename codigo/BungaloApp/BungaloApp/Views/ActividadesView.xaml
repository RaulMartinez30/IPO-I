<UserControl x:Class="BungaloApp.ActividadesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- LISTADO -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GESTIÓN DE ACTIVIDADES" Style="{StaticResource H2}"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="DÍA" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                        <DatePicker x:Name="dpFiltroDia" Width="130" SelectedDateChanged="Filtro_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="TIPO" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbFiltroTipo" Width="130" SelectionChanged="Filtro_Changed"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="MONITOR" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtFiltroMonitor" Width="130" Height="22" ToolTip="Buscar por nombre" TextChanged="Filtro_Changed"/>
                    </StackPanel>
                    <Button Content="Limpiar filtros" Style="{StaticResource BtnGris}" VerticalAlignment="Bottom" Padding="8,2" Click="LimpiarFiltros_Click"/>
                </WrapPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="lblTotal" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button Content="Nueva Actividad  ＋" Style="{StaticResource BtnAzul}" HorizontalAlignment="Right" Click="Nueva_Click"/>
                </DockPanel>
                <DataGrid x:Name="dgAct" SelectionChanged="dgAct_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DÍA-HORA" Binding="{Binding DiaHora}" Width="Auto"/>
                        <DataGridTextColumn Header="ACTIVIDAD" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="MONITOR" Binding="{Binding Monitor}" Width="Auto"/>
                        <DataGridTextColumn Header="PLAZAS" Binding="{Binding Plazas}" Width="Auto"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoIcono}" Foreground="{Binding EstadoColor}" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- DETALLES -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DETALLES DE LA ACTIVIDAD" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Guardar" Style="{StaticResource BtnAzul}" Click="Guardar_Click"/>
                    <Button Content="Eliminar" Style="{StaticResource BtnRojo}" Click="Eliminar_Click"/>
                    <Button Content="Cancelar" Style="{StaticResource BtnGris}" Click="Cancelar_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="ACTIVIDAD:" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtNombre"/>
                                <TextBlock Text="MONITOR:" Style="{StaticResource Lbl}"/>
                                <ComboBox x:Name="cmbMonitor"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="DÍA:" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                <DatePicker x:Name="dpDia"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="INICIO (HH:mm)" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="txtInicio" Width="60"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="FIN (HH:mm)" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="txtFin" Width="60"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <GroupBox Header="Datos técnicos" Margin="0,10,0,0" Padding="6">
                            <StackPanel>
                                <TextBlock Text="DESTINATARIOS:" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="chkAdultos" Content="Adultos" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="chkNinos" Content="Niños" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="chkBebes" Content="Bebés"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="CUPO MÍN" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="txtMin" Width="50"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CUPO MÁX" Style="{StaticResource Lbl}"/>
                                        <TextBox x:Name="txtMax" Width="50"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="UBICACIÓN:" Style="{StaticResource Lbl}"/>
                                <ComboBox x:Name="cmbUbicacion" IsEditable="True"/>
                                <TextBlock Text="NÚMERO DE INSCRITOS:" Style="{StaticResource Lbl}"/>
                                <TextBlock x:Name="lblInscritos"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Detalles avanzados" Margin="0,10,0,0" Padding="6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="PRECIO/HORA (€)" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtPrecioHora" Width="80"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PRECIO/MES (€)" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="txtPrecioMes" Width="80"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="CONSIDERACIONES:" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtConsideraciones"/>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="🎒 MATERIAL NECESARIO" Style="{StaticResource Lbl}" Margin="0,10,0,2"/>
                        <TextBox x:Name="txtMaterial" Height="55" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="📝 DESCRIPCIÓN DE LA ACTIVIDAD" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtDescripcion" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BungaloApp.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- KPIs -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="lblResumen" Style="{StaticResource H1}"/>
                    <UniformGrid Columns="4" Margin="0,10,0,0">
                        <Border Background="#D0D0D0" BorderBrush="Black" BorderThickness="2" Margin="8" Padding="12">
                            <TextBlock x:Name="kpiEntradas" Foreground="Black" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#D0D0D0" BorderBrush="Black" BorderThickness="2" Margin="8" Padding="12">
                            <TextBlock x:Name="kpiLibres" Foreground="Black" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#D0D0D0" BorderBrush="Black" BorderThickness="2" Margin="8" Padding="12">
                            <TextBlock x:Name="kpiOcupacion" Foreground="Black" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="#D0D0D0" BorderBrush="Black" BorderThickness="2" Margin="8" Padding="12">
                            <TextBlock x:Name="kpiPersonal" Foreground="Black" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>
                    <Button x:Name="btnGraficas" Style="{StaticResource BtnAzul}" HorizontalAlignment="Right" Click="btnGraficas_Click"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MAPA -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="lblMapa" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="lblMapaTitulo" FontWeight="SemiBold" FontSize="12"/>
                        <Image x:Name="imgMapa" Height="320" Stretch="Uniform" Cursor="Hand" Margin="0,6" MouseLeftButtonUp="imgMapa_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="14" Height="14" Fill="#4CAF50" Stroke="Black" Margin="4"/>
                            <TextBlock x:Name="lblLibre" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Rectangle Width="14" Height="14" Fill="#E53935" Stroke="Black" Margin="4"/>
                            <TextBlock x:Name="lblOcupado" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Rectangle Width="14" Height="14" Fill="#FDD835" Stroke="Black" Margin="4"/>
                            <TextBlock x:Name="lblReservado" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblPistaMapa" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TABLAS -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Reservas" Style="{StaticResource H2}"/>
                            <DataGrid x:Name="dgReservas" Height="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FECHA ENTRADA" Binding="{Binding FechaEntradaTxt}" Width="Auto"/>
                                    <DataGridTextColumn Header="ID - CLIENTE" Binding="{Binding IdCliente}" Width="*"/>
                                    <DataGridTextColumn Header="ALOJAMIENTO" Binding="{Binding Alojamiento}" Width="Auto"/>
                                    <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="lblProxAct" Style="{StaticResource H2}"/>
                            <DataGrid x:Name="dgActividades" Height="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DÍA" Binding="{Binding FechaTxt}" Width="Auto"/>
                                    <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="Auto"/>
                                    <DataGridTextColumn Header="ACTIVIDAD" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="MONITOR" Binding="{Binding MonitorTxt}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BungaloApp.AlojamientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.1*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- LISTADO -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LISTADO DE ALOJAMIENTOS" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="Filtrar por tipo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbFiltroTipo" Width="150" SelectionChanged="Filtro_Changed"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock x:Name="lblTotales" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" Width="190"/>
                    <Button Content="AÑADIR NUEVO ALOJAMIENTO" Style="{StaticResource BtnAzul}" HorizontalAlignment="Right" Click="Nuevo_Click"/>
                </DockPanel>
                <DataGrid x:Name="dgAloj" SelectionChanged="dgAloj_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="Auto"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="*"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- DETALLES -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DETALLES DEL ALOJAMIENTO" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Guardar" Style="{StaticResource BtnAzul}" Click="Guardar_Click"/>
                    <Button Content="Eliminar" Style="{StaticResource BtnRojo}" Click="Eliminar_Click"/>
                    <Button Content="Cancelar" Style="{StaticResource BtnGris}" Click="Cancelar_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <Border BorderBrush="Black" BorderThickness="1" Height="150" Background="#DDDDDD">
                            <Image x:Name="imgAloj" Stretch="UniformToFill"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="NOMBRE" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtNombre"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="TIPO" Style="{StaticResource Lbl}"/>
                                <ComboBox x:Name="cmbTipo" SelectionChanged="cmbTipo_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="lblEstado" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button x:Name="btnEstado" Grid.Column="1" Content="CAMBIAR ESTADO" Style="{StaticResource BtnAzul}" Click="CambiarEstado_Click"/>
                            <TextBlock x:Name="lblLimpio" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="SOLICITAR LIMPIEZA" Style="{StaticResource BtnAzul}" Click="Limpieza_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="CAPAC. MÁX. PERSONAS" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtCap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="PERSONAS ALOJADAS" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtPers"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="PRECIO NOCHE (€)" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtPrecio"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Text="TAMAÑO (m²)" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtM2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="TEMPORADA" Style="{StaticResource Lbl}"/>
                                <ComboBox x:Name="cmbTemporada"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="EQUIPAMIENTO" Style="{StaticResource Lbl}"/>
                        <WrapPanel>
                            <CheckBox x:Name="chkWifi" Content="Wi-Fi" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chkAire" Content="A/C" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chkLav" Content="Lavadora" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chkTv" Content="TV" Margin="0,0,14,0"/>
                            <CheckBox x:Name="chkMasc" Content="Admite mascotas"/>
                        </WrapPanel>

                        <TextBlock Text="UBICACIÓN" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtUbicacion"/>

                        <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="txtDesc" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

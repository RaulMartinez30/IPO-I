<Window x:Class="BungaloApp.GraficasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRÁFICAS" Height="520" Width="760" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextBrush}">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="GRÁFICAS" Style="{StaticResource H1}"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8">
                <ComboBox x:Name="cmbMetrica" Width="200" SelectionChanged="Cambio"/>
                <RadioButton x:Name="rbLineas" Content="Líneas" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Checked="Cambio"/>
                <RadioButton x:Name="rbBarras" Content="Barras" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Cambio"/>
                <RadioButton x:Name="rbCirculo" Content="Círculo" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Cambio"/>
                <TextBlock x:Name="lblRango" Margin="24,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <Border Background="White" BorderBrush="Black" BorderThickness="1">
                <Canvas x:Name="lienzo" Width="700" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DockPanel>
    </Border>
</Window>

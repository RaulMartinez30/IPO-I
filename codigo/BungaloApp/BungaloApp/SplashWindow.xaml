<Window x:Class="BungaloApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar App" Height="450" Width="700"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <Grid>
        <!-- Un borde redondeado blanco para toda la pantalla -->
        <Border Background="White" CornerRadius="15">
            <Border.Effect>
                <!-- Sombra suave para darle volumen -->
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Tu logotipo (Asegúrate de guardarlo en una carpeta Assets de tu proyecto como se ve a la derecha) -->
                <Image Source="Images/ICONO_BUNGALO.png" Width="190" Height="190" Margin="10"/>

                <!-- Nombre de la App con la inclinación del boceto -->
                <TextBlock Text="BUNGALO" FontSize="42" FontFamily="Segoe UI Black" Foreground="#1E1E1E" HorizontalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="APP" FontSize="28" FontFamily="Segoe UI Black" Foreground="#D35400" Margin="110,-10,0,0">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Barra de carga animada -->
                <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,35,0,5" Foreground="#2ECC71" Background="#E0E0E0" BorderThickness="0"/>
                <TextBlock Text="Cargando..." FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
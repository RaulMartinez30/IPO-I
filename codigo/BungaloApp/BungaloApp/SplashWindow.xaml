<Window x:Class="BungaloApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrar App" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Triggers>
        <!-- Esto hace que la animación salte sola al abrir la ventana -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. El fondo entra desde abajo con un fade in -->
                    <DoubleAnimation Storyboard.TargetName="MainBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="TransMain"
                                     Storyboard.TargetProperty="Y"
                                     From="30" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 2. El logo del bungalo hace un efecto rebote (Pop) -->
                    <DoubleAnimation Storyboard.TargetName="ScaleLogo"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScaleLogo"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0" To="1" Duration="0:0:0.8" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 3. BUNGALO entra deslizando desde la izquierda -->
                    <DoubleAnimation Storyboard.TargetName="TransTitulo"
                                     Storyboard.TargetProperty="X"
                                     From="-50" To="0" Duration="0:0:0.5" BeginTime="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TextTitulo"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.4"/>

                    <!-- 4. APP entra deslizando desde la derecha -->
                    <DoubleAnimation Storyboard.TargetName="TransApp"
                                     Storyboard.TargetProperty="X"
                                     From="50" To="0" Duration="0:0:0.5" BeginTime="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TextApp"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.5"/>

                    <!-- 5. La barra y el texto de carga aparecen suavemente al final -->
                    <DoubleAnimation Storyboard.TargetName="PanelCarga"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="MainBorder" Background="White" CornerRadius="15" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="TransMain" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <Image Source="Images/ICONO_BUNGALO.png" Width="190" Height="190" Margin="10" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="ScaleLogo" ScaleX="0" ScaleY="0"/>
                    </Image.RenderTransform>
                </Image>

                <!-- TransformGroup para mantener tu inclinación de -8 grados y añadir el movimiento -->
                <TextBlock x:Name="TextTitulo" Text="BUNGALO" FontSize="42" FontFamily="Segoe UI Black" Foreground="#1E1E1E" HorizontalAlignment="Center" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-8"/>
                            <TranslateTransform x:Name="TransTitulo" X="0"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="TextApp" Text="APP" FontSize="28" FontFamily="Segoe UI Black" Foreground="#D35400" Margin="110,-10,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-8"/>
                            <TranslateTransform x:Name="TransApp" X="0"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel x:Name="PanelCarga" Opacity="0">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,35,0,5" Foreground="#2ECC71" Background="#E0E0E0" BorderThickness="0"/>
                    <TextBlock Text="Cargando..." FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
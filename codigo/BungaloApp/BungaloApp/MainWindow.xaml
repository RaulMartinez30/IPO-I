<Window x:Class="BungaloApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bungalo APP" Height="780" Width="1280" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Padding="4,10" Margin="5,4" CornerRadius="4"
                                BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#335DADE2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5DADE2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Black"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,2" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#BDBDBD" BorderBrush="Black" BorderThickness="1">
                        <Image x:Name="imgAvatar" Width="56" Height="56" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="28,28" RadiusX="27" RadiusY="27"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtUsuario" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtUltimoAcceso" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAvisos" Background="#FFA000" Foreground="Black" FontWeight="Bold"
                            BorderBrush="Black" BorderThickness="2" Padding="12,5" Margin="0,0,10,0" Cursor="Hand"
                            Click="btnAvisos_Click"/>
                    <Button x:Name="btnIdioma" Style="{StaticResource IconBtn}" FontSize="15" FontWeight="Bold" Click="btnIdioma_Click"/>
                    <Button x:Name="btnAyuda" Style="{StaticResource IconBtn}" Content="📖" Click="btnAyuda_Click"/>
                    <Button x:Name="btnAjustes" Style="{StaticResource IconBtn}" Content="⚙" Click="btnAjustes_Click"/>
                    <Button x:Name="btnSalir" Style="{StaticResource IconBtn}" Content="🚪" Click="btnSalir_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lstNav" Grid.Column="0" Background="{DynamicResource PanelBg}"
                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,2,0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     HorizontalContentAlignment="Stretch"
                     SelectionChanged="lstNav_SelectionChanged"/>

            <ContentControl x:Name="contenido" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
